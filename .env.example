# --- Database ---
# SQLite file path relative to the prisma/ directory
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Secret used to sign session JWTs (HS256). Generate a long random value in production.
JWT_SECRET="replace-with-a-long-random-secret"

# --- Private file storage ---
# Directory for uploaded book files. Must NOT be inside public/.
STORAGE_DIR="./storage/books"

# --- Bootstrap admin (used by `npm run db:seed`) ---
ADMIN_EMAIL="admin@luja.local"
ADMIN_PASSWORD="replace-with-a-strong-password"

# --- Invitations ---
INVITATION_TTL_DAYS=7

# --- Uploads ---
MAX_UPLOAD_MB=50

# --- Cloudinary (optional: stores book files and cover images instead of local disk) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
